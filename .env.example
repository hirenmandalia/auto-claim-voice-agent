# Copy this file to .env and add your key:  cp .env.example .env
# Get a key at https://aistudio.google.com/apikey

GOOGLE_API_KEY=replace-me
GOOGLE_GENAI_USE_VERTEXAI=False

# ---- Models and voice (defaults shown) ----
# FNOL_GEMINI_LIVE_MODEL=gemini-3.8-live
# FNOL_VOICE=Kore
# FNOL_BRAND=Wrenfield Insurance   # fictional insurer name the agent uses

# ---- Scope and guardrails (defaults shown) ----
# FNOL_AUTO_ONLY=on        # off = accept home, health, travel claims too (original multi-line demo)
# FNOL_SKETCH=off          # on  = let the agent draw an illustration of the incident
# FNOL_SKETCH_MODEL=gemini-3.1-flash-image

# ---- Voice behavior (defaults shown) ----
# FNOL_BARGE_IN=on         # off = the agent always finishes its sentence; good for noisy rooms
# FNOL_VAD_SILENCE_MS=900  # how long a pause ends your turn

# ---- Network access ----
# The server accepts connections from this machine only, unless one of these is set.
# FNOL_ALLOW_LAN=1         # phones on the same Wi-Fi (run_phone.sh sets this for you)
# FNOL_TRUST_PROXY=1       # only if you deliberately put the demo behind an HTTPS tunnel
